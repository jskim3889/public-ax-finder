# 공공 AX 사례 찾기가 쓰는 외부 리소스와 설정. 값은 넣지 않는다 (Vercel 환경변수, 로컬은 ~/.ghost-alice/secrets.env)
# 소유: 지금 누구 계정인지 / 이전: 회사 리소스로 옮길 때 할 일. 자세한 순서는 README "리소스 이전"

# --- 검색 (필수) ---
# 소유: 개인 OpenRouter 계정 / 이전: 회사 OpenRouter 조직 키로 교체. 같은 임베딩 모델이면 색인을 다시 만들 필요 없음
OPENROUTER_API_KEY=

# --- 자료 메일 받기 (LEAD_FORM_ENABLED=1일 때) ---
LEAD_FORM_ENABLED=
OPERATOR_NAME=
# 소유: 회사 메일 / 이전: 문의 수신 담당 주소로 지정
LEAD_TO=
# 처리방침에 표시. 회사 이전 시 회사 개인정보 보호책임자로 지정
PRIVACY_OFFICER=
PRIVACY_CONTACT=
# 매일 자동 삭제(/api/purge) 비밀값. 임의의 긴 문자열
CRON_SECRET=
# 소유: 개인 Gmail 또는 회사 하이웍스 / 이전: 회사 하이웍스 발송 전용 계정(SMTP_HOST=smtps.hiworks.com)
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
# 소유: 개인 GitHub로 가입한 Supabase / 이전: 회사 Supabase 조직에 새 프로젝트 → schema.sql 실행 → 기존 행 옮김
SUPABASE_URL=
SUPABASE_KEY=
# AI 요약 모델. OpenRouter 키를 따라간다
REPORT_MODEL=
# 소유: 개인 GitHub Pages·Vercel 주소 / 이전: 회사 도메인으로 바꾸면 여기만 수정
SITE_URL=
MAP_URL=

# --- 데이터 갱신 (배포 서버에는 필요 없음) ---
# 소유: 개인 공공데이터포털 계정 / 이전: 회사 계정으로 같은 API(15129394, 15129462) 활용 신청
DATA_GO_KR_SERVICE_KEY=

# --- 로컬 시험 전용 ---
MAIL_DRY_RUN=
LEADS_STORE=
